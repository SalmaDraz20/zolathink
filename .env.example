# Notion-backed cards (/card). Set these in Vercel > Settings > Environment Variables.
NOTION_TOKEN=
NOTION_CARDS_DB=41c9d1ebed01817dba16fd57131bb608
NOTION_RESPONSES_DB=41c9d1ebed0181fc973dc60455880a53
# Certificates (/certificate): the "Student Profiles" Notion database (Name, Code, Certificate ID, Certificate PDF,
# Title (لقب), Skills acquired, M0–M4 project). Share it with the same integration as NOTION_TOKEN.
NOTION_CERTS_DB=41f9d1ebed0181df8d7ad52117f83542
# Mission 0 bookings (popup on the site) are saved as rows in the Notion "Mission 0" database.
NOTION_MISSION0_DB=41c9d1ebed0181db90acedfd5216a416
# Student projects gallery on the landing page ("Projects Gallery · Journey 1"). Only rows with "Show on site" ticked appear.
NOTION_PROJECTS_DB=41f9d1ebed01814a8ab1e8c02a6a5c2f
# Card questions ("أسئلة الكروت"): one row per question, the "النوع" column decides the UI on /card.
NOTION_QUESTIONS_DB=41f9d1ebed0181b898badaa43ec6fd3f

# Mission 0 time slots (table "مواعيد Mission 0"), edited from /admin
NOTION_SLOTS_DB=4209d1ebed0181758817df7068e69fc7
# /admin password (set it in Vercel, never in the code)
ADMIN_PASSWORD=
