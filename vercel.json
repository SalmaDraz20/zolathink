{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/mission-zero/register.js": {
      "maxDuration": 15
    },
    "api/card.js": {
      "maxDuration": 15
    },
    "api/card-submit.js": {
      "maxDuration": 15
    },
    "api/certificate.js": {
      "maxDuration": 15
    },
    "api/projects.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/mission1",
      "destination": "/mission1.html"
    },
    {
      "source": "/card",
      "destination": "/live-card.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/schools",
      "destination": "/schools.html"
    },
    {
      "source": "/certificate",
      "destination": "/certificate.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    }
  ]
}
