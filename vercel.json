{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/mission-zero/register.js": {
      "maxDuration": 15
    },
    "api/card.js": {
      "maxDuration": 15
    },
    "api/card-submit.js": {
      "maxDuration": 15
    },
    "api/certificate.js": {
      "maxDuration": 15
    },
    "api/projects.js": {
      "maxDuration": 15
    },
    "api/admin.js": {
      "maxDuration": 30
    },
    "api/slots.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/mission1",
      "destination": "/mission1.html"
    },
    {
      "source": "/card",
      "destination": "/live-card.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/schools",
      "destination": "/schools.html"
    },
    {
      "source": "/certificate",
      "destination": "/certificate.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "redirects": [
    {
      "source": "/certificate.html",
      "destination": "/certificate",
      "permanent": true
    },
    {
      "source": "/admin.html",
      "destination": "/admin",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
